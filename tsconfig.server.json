{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "express", "bcryptjs", "jsonwebtoken", "cors"]
  },
  "include": ["server/src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
